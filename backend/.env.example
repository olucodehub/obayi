# Environment Configuration
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Database Configuration
DATABASE_PATH=./database.sqlite

# Server Configuration
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://obayi.co

# Azure Storage (if using file uploads)
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=uploads

# Azure Logic App Email Service
# This is the HTTP POST URL from your Logic App trigger
LOGIC_APP_WEBHOOK_URL=https://prod-XX.region.logic.azure.com:443/workflows/xxxxx/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=xxxxx