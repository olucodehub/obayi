# Production Environment Variables
# This file is used when building for production (npm run build)

# Set authentication mode to use backend API (not localStorage)
VITE_AUTH_MODE=api

# Production Backend API URL - Azure deployment
VITE_API_URL=https://obayibackend-b2e8bjfkd8gpbeg6.westeurope-01.azurewebsites.net/api

# Disable debug logs in production
VITE_DEBUG=false
